<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>CaaS</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/stylesheets/index.css' />
</head>
<body>

<div id="main">
    <div>
        <a href="/upload-file"><button>Load Files</button></a>
<!--        <button>+ Archivo</button>-->
<!--        <button>+ Carpeta</button>-->
        <button id="saveButton">Save</button>

    </div>
    <div id="top">
        <div>
            <input id="file-tree-range" type="range" min="1" max="200" value="100">
        </div>

        <div>
            <button id="compileButton">Compile to 3D</button>
            <button id="executeButton">Execute 3D :v</button>
        </div>

        <div>
            <button id="debugButton">Debug</button>
            <button id="stepButton">Step </button>
            <button id="symbolsButton" >Simbolos</button>
            <input id="editor-3d-range" type="range" min="1" max="400" value="200">

        </div>

    </div>

    <div id="central">
        <div id="editors">
            <div id="file-tree">
                archivos
            </div>
            <div id="editors-java">

                <div id="tabs">
                </div>
                <div id="tab-content"></div>

            </div>
            <div id="editor-3d"></div>
        </div>
        <div id="outputs">
            <textarea id="consoleTextArea" cols="30" rows="10"></textarea>
        </div>
    </div>
    <div id="bottom">
        <button id="errorsButton">Errores</button>
    </div>

</div>


<div id="errorsDiv">
    <table>
        <thead>
        <tr>
            <th>Tipo</th>
            <th>Archivo</th>
            <th>Linea</th>
            <th>Columna</th>
            <th>Mensaje</th>
        </tr>
        </thead>
        <tbody id="errorsBody">

        </tbody>
    </table>

</div>

